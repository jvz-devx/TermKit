{
	"name": "termixkit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run build:server",
		"build:server": "node scripts/build-server.mjs",
		"audit:acceptance": "node scripts/acceptance-audit.mjs",
		"acceptance:github-microsoft": "node scripts/github-microsoft-acceptance.mjs",
		"acceptance:import-microsoft-smoke": "node scripts/import-microsoft-smoke-proof.mjs",
		"acceptance:microsoft-interactive-preflight": "node scripts/microsoft-interactive-preflight.mjs",
		"acceptance:proof-template": "node scripts/acceptance-proof-template.mjs",
		"acceptance:refresh-local-v1-proofs": "node scripts/refresh-local-v1-proofs.mjs",
		"acceptance:record-real-rdp": "node scripts/record-external-proof.mjs realRdp",
		"acceptance:record-real-ssh": "node scripts/record-external-proof.mjs realSsh",
		"acceptance:record-real-vnc": "node scripts/record-external-proof.mjs realVnc",
		"acceptance:record-microsoft-interactive": "node scripts/record-microsoft-interactive-proof.mjs",
		"acceptance:record-microsoft-smoke": "node scripts/record-microsoft-smoke-proof.mjs",
		"preview": "vite preview",
		"start": "node scripts/start-production.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "node scripts/run-playwright.mjs",
		"test:unit": "vitest",
		"smoke:postgres": "node scripts/smoke-postgres-migrations.mjs",
		"smoke:compose": "node scripts/smoke-compose.mjs",
		"smoke:protocols": "node scripts/smoke-protocols.mjs",
		"smoke:app-protocols": "node scripts/smoke-app-protocols.mjs",
		"smoke:microsoft": "node scripts/smoke-microsoft-entra.mjs",
		"smoke:rdp-gateway": "node scripts/smoke-rdp-gateway.mjs",
		"smoke:ws": "node scripts/smoke-production-websocket.mjs",
		"test": "npm run test:unit -- --run",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "node scripts/migrate.mjs",
		"db:studio": "drizzle-kit studio"
	},
