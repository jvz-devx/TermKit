		"@devolutions/iron-remote-desktop-rdp": "^0.6.1",
		"@novnc/novnc": "^1.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"basic-ftp": "^6.0.1",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"ssh2": "^1.17.0",
		"ws": "^8.20.1"
	}
}
