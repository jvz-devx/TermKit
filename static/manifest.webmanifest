{
	"name": "TermKit",
	"short_name": "TermKit",
	"description": "Secure browser workspace for SSH, RDP, VNC, SFTP, FTP and tunnel operations.",
	"start_url": "/sessions",
	"scope": "/",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#09090b",
	"theme_color": "#18181b",
	"categories": ["productivity", "utilities"],
	"icons": [
		{
			"src": "/pwa/icon-192.png",
			"type": "image/png",
			"sizes": "192x192",
			"purpose": "any"
		},
		{
			"src": "/pwa/icon-512.png",
			"type": "image/png",
			"sizes": "512x512",
			"purpose": "any"
		},
		{
			"src": "/pwa/icon-maskable-512.png",
			"type": "image/png",
			"sizes": "512x512",
			"purpose": "maskable"
		},
		{
			"src": "/pwa/icon.svg",
			"type": "image/svg+xml",
			"sizes": "any",
			"purpose": "any"
		},
		{
			"src": "/pwa/icon-maskable.svg",
			"type": "image/svg+xml",
			"sizes": "any",
			"purpose": "maskable"
		}
	]
}
