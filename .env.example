# Public URL used by SvelteKit for redirects and secure-cookie decisions.
# Production deployments should use https://. Local direct HTTP for ORIGIN and
# GATEWAY_PUBLIC_URL must opt in explicitly with TERMIXKIT_INSECURE_LOCAL_HTTP=1.
ORIGIN="http://localhost:3000"
TERMIXKIT_INSECURE_LOCAL_HTTP="1"
APP_PORT="3000"
# Session token hashing secret. Use a high-entropy value and keep it stable across restarts.
APP_SECRET=""
# Global adapter/custom-server request body cap. Keep above the largest route upload limit
# to leave room for multipart overhead; oversized bodies return 413.
BODY_SIZE_LIMIT="55M"

# Database. Compose defaults DATABASE_URL to the internal postgres service.
POSTGRES_USER="termixkit"
POSTGRES_PASSWORD=""
POSTGRES_DB="termixkit"
POSTGRES_PORT="5432"
DATABASE_URL="postgres://termixkit:change-me@localhost:5432/termixkit"

# Credential encryption. Use a high-entropy value and keep it stable across restarts.
CREDENTIAL_MASTER_KEY=""

# Microsoft Entra login. Leave disabled to use only local username/password auth.
# When enabled in production, startup requires tenant-specific OIDC settings, at
# least one allowed email domain, and at least one admin email for provisioning.
MICROSOFT_AUTH_ENABLED="0"
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_ALLOWED_DOMAINS=""
MICROSOFT_ADMIN_EMAILS=""

# SSH/SFTP host-key trust. By default, unpinned host keys are rejected before auth.
# Enable TOFU only for trusted enrollment; production requires the extra override.
TERMIXKIT_SSH_KNOWN_HOSTS_PATH=""
TERMIXKIT_SSH_TRUST_ON_FIRST_USE="0"
TERMIXKIT_SSH_ALLOW_PRODUCTION_TOFU="0"

# Devolutions Gateway wiring for the V1 RDP integration. Keep only the app port
# public; Gateway stays on the Compose network. The public URL must stay on the
# app origin at /gateway, and the app proxies /gateway/jet traffic internally.
# The localhost value is only for local Compose with TERMIXKIT_INSECURE_LOCAL_HTTP=1.
GATEWAY_URL="http://gateway:7171"
GATEWAY_PUBLIC_URL="http://localhost:3000/gateway"
GATEWAY_PROVISIONER_KEY=""
DEVOLUTIONS_GATEWAY_TAG="2026.1.1"
DGW_LISTEN="0.0.0.0:7171"
DGW_SUBJECT="localhost"
